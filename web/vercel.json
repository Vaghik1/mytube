{
  "redirects": [
    {
      "source": "/apk",
      "destination": "https://github.com/Vaghik1/mytube/releases/latest/download/mytube.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/hub?r=mcp"
    },
    {
      "source": "/api/picks",
      "destination": "/api/hub?r=picks"
    },
    {
      "source": "/api/sync",
      "destination": "/api/hub?r=sync"
    },
    {
      "source": "/api/remote",
      "destination": "/api/hub?r=remote"
    },
    {
      "source": "/((?!api/|assets/|icon-|favicon).*)",
      "destination": "/index.html"
    }
  ]
}